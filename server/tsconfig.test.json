// `pnpm typecheck` runs this (server/package.json "typecheck"): it checks src AND
// test in one no-emit program. rootDir is widened because tests import
// ../shared/src; `pnpm build` (tsconfig.json) still enforces rootDir ./src.
// Until 2026-09-25 nothing typechecked server/test, and fixtures drifted from
// the real types (missing `done`, stale provider handles) while tsx ran them.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
