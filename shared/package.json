{
  "name": "@unleashd/shared",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch:esm": "tsc --watch",
    "watch:cjs": "tsc -p tsconfig.cjs.json --watch",
    "gen:catalog": "tsx scripts/gen-catalog.ts",
    "check:catalog": "tsx scripts/gen-catalog.ts && git diff --exit-code -- src/generated/catalog.ts",
    "prepack": "pnpm run check:catalog"
  },
  "files": ["dist"],
  "peerDependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@unleashd/buddies-core": "workspace:*",
    "@unleashd/ingest": "workspace:*",
    "typescript": "^5.7.2",
    "zod": "^3.24.0"
  }
}
