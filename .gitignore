# Dependencies
node_modules/

# Local Buddy runtime state
.buddies/

# Build output
dist/
# Dev-only esbuild bundle of the Buddy MCP helpers (server/src/buddies/mcp-bundle.ts)
server/.mcp-bundle/
build/
*.tsbuildinfo

# Logs
*.log
server.log

# Environment
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test coverage
coverage/
.playwright-cli/
output/playwright/
output/screenshots/

# Temporary files
*.tmp
*.temp

# Local planning scratch (not committed)
# Markdown under product/ is tracked — product plans are durable intent, not
# scratch. The negation must cover SUBDIRECTORIES: `!product/*.md` alone only
# re-includes the top level, so `product/buddies/*.md` silently stayed ignored
# when docs were foldered on 2026-08-21. Directories need their own negation or
# git never descends into them to see the .md files.
product/**
!product/
!product/**/
!product/**/*.md
# Launch-video design sources (HTML, render script, logos, font, stills, short
# renders) are durable assets, re-exported when the UI changes. Raw screen
# footage (footage/, tens of MB of .mov) stays ignored.
!product/releases/launch-2.0/beat9/**
!product/releases/launch-2.0/drafts/**
!product/releases/launch-2.0/fonts/**
!product/design/**
!product/releases/launch-2.0/logos/**
!product/releases/launch-2.0/brand/**
# Remotion edit project; its own .gitignore keeps node_modules/ and out/ renders out.
!product/releases/launch-2.0/edit/**
output

# Buddy memory profiles — generated runtime state (same class as .buddies/).
# Each profiles/<buddyId>/memory/*.md carries a generated `updated:` timestamp
# and is rewritten on every turn, so committing it churns the tree constantly.
profiles/

# Raw benchmark runs stay local. A dated benchmark directory commits only its
# top-level README, prompts, grades and sha256.json; each subdirectory is a
# folder of raw run JSON or source snapshots (~20k lines for one date).
docs/benchmarks/*/*/*/

# Agent worktrees (Claude Code Agent/Workflow isolation); never source.
.claude/worktrees/
