{
  "name": "unleashd",
  "version": "1.1.0",
  "private": false,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "preinstall": "node tools/preflight.mjs",
    "prepack": "pnpm build",
    "bootstrap": "pnpm install --frozen-lockfile --offline && pnpm --dir vendor/agent-cli-tool run build && pnpm --dir shared run build && node tools/ensure-addons.mjs",
    "addons": "node tools/ensure-addons.mjs",
    "dev": "node tools/dev-supervisor.mjs",
    "dev:replace": "node tools/dev-supervisor.mjs --replace",
    "dev:server": "node tools/dev-supervisor.mjs --task dev-server",
    "dev:client": "node tools/dev-supervisor.mjs --task dev-client",
    "errors:list": "pnpm exec tsx tools/error-log.ts",
    "token-audit": "pnpm exec tsx tools/token-audit.ts",
    "local-domain:setup": "sudo bash tools/setup-domain.sh install",
    "local-domain:remove": "sudo bash tools/setup-domain.sh remove",
    "build": "node tools/dev-supervisor.mjs --task build",
    "start": "node server/dist/server.js",
    "typecheck": "node tools/dev-supervisor.mjs --task typecheck",
    "test": "pnpm typecheck && pnpm test:package && pnpm test:server && pnpm test:client && pnpm test:dev-supervisor && pnpm test:tools && pnpm test:cli && pnpm test:api",
    "test:server": "node tools/ensure-addons.mjs && pnpm exec tsx --test server/test/*.test.ts",
    "test:client": "pnpm exec tsx --tsconfig client/tsconfig.test.json --test client/test/*.test.ts client/test/*.test.tsx",
    "screenshot:mobile": "node tools/screenshot-mobile.mjs",
    "screenshots": "node tools/screenshots.mjs",
    "test:dev-supervisor": "node --test tools/dev-supervisor.test.mjs tools/local-domain.test.mjs tools/shared-build.test.mjs tools/watch-server.test.mjs",
    "test:tools": "node --test tools/preflight.test.mjs tools/lib/pixel-diff.test.mjs tools/ensure-addons.test.mjs",
    "test:cli": "pnpm --dir vendor/agent-cli-tool test",
    "test:api": "node test/api.test.js",
    "test:package": "pnpm build && node test/package-smoke.js",
    "sub:latest": "git submodule update --remote --merge vendor/agent-cli-tool && git -C vendor/agent-cli-tool log --oneline -1",
    "check:catalog": "pnpm --filter @unleashd/shared check:catalog",
    "check:client-invariants": "bash tools/check-client-invariants.sh",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "json-schema-to-typescript": "^15.0.4",
    "tsx": "^4.7.0"
  },
  "bin": {
    "unleashd": "./bin/unleashd.js",
    "buddies": "./bin/unleashd.js"
  },
  "files": ["bin", "tools/preflight.mjs", "server/dist", "client/dist"],
  "bundledDependencies": ["@nbardy/agent-cli", "@unleashd/buddies-core", "@unleashd/shared"],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nbardy/agent-cli": "workspace:0.1.1",
    "@unleashd/buddies-core": "workspace:0.1.0",
    "@unleashd/shared": "workspace:1.0.0",
    "compression": "^1.8.1",
    "express": "^4.18.2",
    "multer": "^2.0.2",
    "uuid": "^13.0.0",
    "ws": "^8.14.2",
    "zod": "^3.24.0"
  }
}
